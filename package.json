    "@sanity/vision": "^5.31.2",
    "lucide-react": "^1.45.0",
    "motion": "^13.2.0",
    "next": "16.3.5",
    "next-sanity": "^13.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanity": "^5.31.2",
    "styled-components": "^6.5.3",
    "tailwind-merge": "^3.6.0"
