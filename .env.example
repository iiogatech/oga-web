# Sanity project — from https://www.sanity.io/manage after creating/linking a project
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-13

# Server-only. Viewer token, used for draft-mode reads. Sanity → API → Tokens.
SANITY_API_READ_TOKEN=

# Server-only. Shared secret checked against the Sanity webhook payload signature.
SANITY_REVALIDATE_SECRET=

# Server-only, local use only. Editor/Write token for the one-time scripts/seed.ts.
# Revoke it in Sanity → API → Tokens once seeding is done.
SANITY_API_WRITE_TOKEN=
